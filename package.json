{
  "name": "geoops-console",
  "version": "0.1.0",
  "private": true,
  "description": "GeoOps Console - location enrichment backend demo (public/synthetic data only)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf:typecheck": "tsc -p worker/tsconfig.json",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.1.1",
    "fastify": "^5.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260926.1",
    "@types/node": "^20.14.10",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^2.0.5",
    "wrangler": "^4.141.0"
  }
}
